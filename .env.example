# Copy to .env.local and fill in from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Used only by the command-line scripts (load-plan, add-advisor, offboard,
# seed-demo). Never add it to Vercel: the app itself never needs it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Where sign-in links point. http://localhost:3000 locally.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
